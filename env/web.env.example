NEXT_PUBLIC_PLATFORM_FEE_BPS=200
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_SWAP=true
NEXT_PUBLIC_ENABLE_BRIDGE=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_DEVELOPER_PORTAL=true
