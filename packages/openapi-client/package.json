    "test": "node ../../scripts/workspace-lifecycle.mjs test .",
    "lint": "node ../../scripts/workspace-lifecycle.mjs lint ."
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerchain-protocol/powerchain.git",
    "directory": "packages/openapi-client"
  },
  "homepage": "https://github.com/powerchain-protocol/powerchain/tree/main/packages/openapi-client#readme",
  "bugs": {
    "url": "https://github.com/powerchain-protocol/powerchain/issues"
  }
