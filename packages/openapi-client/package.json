{
  "name": "@powerchain/openapi-client",
  "version": "1.0.0-beta.1",
  "description": "Typed Powerchain OpenAPI client metadata.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
