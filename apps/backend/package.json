{
  "name": "@powerchain/backend",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "migrate:status": "prisma migrate status",
    "routes:list": "tsx scripts/list-routes.ts",
    "db:validate": "prisma validate",
    "test": "node ../../scripts/workspace-lifecycle.mjs test .",
    "lint": "node ../../scripts/workspace-lifecycle.mjs lint ."
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@powerchain/config": "workspace:*",
    "@powerchain/email": "workspace:*",
    "@powerchain/types": "workspace:*",
    "@powerchain/utils": "workspace:*",
    "fastify": "5.10.0",
    "@neondatabase/serverless": "latest",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "latest",
    "@fastify/multipart": "latest",
    "@powerchain/shared": "workspace:*",
    "@powerchain/storage": "workspace:*",
    "@powerchain/integrations": "workspace:*",
    "@powerchain/data": "workspace:*",
    "@fastify/rate-limit": "latest",
    "@powerchain/checkout": "workspace:*",
    "@powerchain/marketplace": "workspace:*",
    "@powerchain/renewables": "workspace:*",
    "@powerchain/payments": "workspace:*",
    "@powerchain/wallet": "workspace:*",
    "@powerchain/ai": "workspace:*",
    "@powerchain/blockchain": "workspace:*",
    "@solana/spl-token": "latest",
    "@metaplex-foundation/mpl-token-metadata": "latest",
    "@metaplex-foundation/umi": "latest",
    "@metaplex-foundation/umi-bundle-defaults": "latest",
    "@powerchain/solana-infrastructure": "workspace:*",
    "@fastify/swagger": "latest",
    "@fastify/swagger-ui": "latest",
    "fastify-plugin": "latest",
    "zod": "latest",
    "@powerchain/web3.js": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "pg": "8.16.3",
    "dotenv": "17.2.1",
    "@powerchain/schemas": "workspace:*",
    "@powerchain/saas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "7.0.2",
    "prisma": "7.9.1",
    "@types/pg": "8.15.5"
  },
  "description": "Powerchain Fastify API for wallets, energy markets, devices, payments, analytics, and settlement.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerchain-protocol/powerchain.git",
    "directory": "apps/backend"
  },
  "homepage": "https://github.com/powerchain-protocol/powerchain/tree/main/apps/backend#readme",
  "bugs": {
    "url": "https://github.com/powerchain-protocol/powerchain/issues"
  }
}
