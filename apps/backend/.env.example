
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
BIRDEYE_API_KEY=

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SHADOW_DATABASE_URL=
NEON_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMBEDDED_WALLET_API_KEY=

# Circle CCTP
CIRCLE_API_KEY=
CCTP_ENABLED=true
CCTP_ATTESTATION_API=https://iris-api.circle.com

# x402 micropayments
X402_ENABLED=true
X402_NETWORK=solana
X402_ENERGY_QUOTE_PRICE=10000

# Integrations
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
STREAMFLOW_API_URL=
CETUS_API_URL=https://api-sui.cetus.zone
ORCA_API_URL=https://api.orca.so
METEORA_API_URL=https://dlmm-api.meteora.ag
DEXSCREENER_API=https://api.dexscreener.com/latest
CHAINLINK_RPC_URL=

# IoT / DePIN / Energy
IOT_INGEST_API_KEY=
DEPIN_REWARD_PROGRAM_ID=
ENERGY_MARKET_REGION=FI

JUPITER_API_KEY=
SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_ALLOW_CUSTOM_RPC=true
ALLOWED_CUSTOM_RPC_HOSTS=localhost,127.0.0.1

PWRC_MAINNET_MINT=
NEXT_PUBLIC_PWRC_MAINNET_MINT=
NEXT_PUBLIC_PWRC_DEVNET_MINT=

ENABLE_SWAGGER=true
API_PUBLIC_URL=http://localhost:4000
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
NEXT_PUBLIC_DATA_ENVIRONMENT=mock
NEXT_PUBLIC_ALLOW_MOCK_FALLBACK=true
REQUEST_TIMEOUT_MS=15000

# Security and reliability
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
REQUEST_TIMEOUT_MS=15000
ENABLE_SWAGGER=true
ALLOW_MOCK_DATA=false

# Exchange aggregation (HTTPS is required in production)
JUPITER_API_URL=https://quote-api.jup.ag/v6/
ENABLE_JUPITER_EXCHANGE=true
EXCHANGE_TIMEOUT_MS=8000
# Optional adapter endpoints; providers remain disabled until configured.
RAYDIUM_API_URL=
ORCA_API_URL=
CETUS_API_URL=
AFTERMATH_API_URL=
