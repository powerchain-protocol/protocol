  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/react": "19.2.17",
    "@types/react-dom": "latest",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerchain-protocol/powerchain.git",
    "directory": "apps/docs"
  },
  "homepage": "https://github.com/powerchain-protocol/powerchain/tree/main/apps/docs#readme",
